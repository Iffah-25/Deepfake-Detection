# Backend Configuration Example

# Comma-separated list of allowed frontend origins (your Vercel domain and custom domain)
# Example: https://deepfake-detection.vercel.app,https://mycustomdomain.com
ALLOWED_ORIGINS=https://deepfake-detection.vercel.app

# Optional regex for Vercel preview deployments. Defaults to ^https://.*\.vercel\.app$
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Optional direct download URL for model checkpoint if not included in repository.
# Upload afem_v2_xception_best.pth to GitHub Releases or Cloud Storage and paste the direct download URL here.
# Example: https://github.com/Iffah-25/Deepfake-Detection/releases/download/v1.0.0/afem_v2_xception_best.pth
CHECKPOINT_URL=

# Optional custom checkpoint path (defaults to checkpoints/afem_v2_xception_best.pth)
CHECKPOINT_PATH=

# Server port (defaults to 8000 locally, standard cloud hosts set PORT automatically)
PORT=8000
